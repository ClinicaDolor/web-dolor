  "help_catalog": [
    {
      "module_id": "M02",
      "stable_id_prefix": "M02:family:",
      "text": "Escribe qué familiar o familiares tienen esta enfermedad. Puedes responder con tus propias palabras, por ejemplo: “mi papá y mi mamá” o “mis padres y mi hermana mayor”. Si ninguno tiene esta enfermedad, selecciona “No, guardar y continuar”. Si no lo recuerdas, puedes indicarlo; no se registrará como Sí ni como No y la respuesta quedará sin guardar.",
      "text_sha256": "dcf5b27872d24d039cf6fefa3b891b9be77bf8746d50b859a45857a29f2506f6",
      "audio_file": "M02-help-generic.mp3",
      "audio_sha256": "751a79f363804d0321540afacdca4b875e912da675603b08a97a27b7b21e2e97"
    },
    {
      "module_id": "M02",
      "stable_ids": ["M02:family:diabetes-mellitus"],
      "text": "Escribe qué familiar o familiares tienen diabetes. Puedes mencionar uno o varios, por ejemplo: “mi papá” o “mis padres y mi hermana”. Si conoces el tipo de diabetes, también puedes incluirlo, pero no es obligatorio.",
      "text_sha256": "270890c3ad0fec2d24669fb997515180aef2ebbbf5622db8c8441b55b3730b80",
      "audio_file": "M02-help-diabetes.mp3",
      "audio_sha256": "06e7ec0208cc4ef5d19d97f7015d18f2c0a2d57011deb73677be8c3a0ab59619"
    }
  ],
